{
  "name": "aerodrome-slipstream-bot",
  "version": "1.0.0",
  "description": "Automated zero-swap concentrated liquidity bot for Aerodrome Slipstream on Base",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/server/public', 'dist/server/public', {recursive: true})\"",
    "start": "ts-node src/index.ts",
    "dev": "ts-node src/index.ts",
    "serve": "node dist/index.js",
    "create-position": "ts-node src/scripts/create-position.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
